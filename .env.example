# ============================================================
# نمونه‌ی تنظیمات — مقادیر زیر فقط «نمونه/جایگزین» هستند (هیچ اطلاعات واقعی اینجا نیست).
#
# معمولاً لازم نیست این فایل را دستی ویرایش کنید: ./install.sh و ./start.sh --setup
# فایل .env را خودکار می‌سازند و دسترسی آن را روی 600 می‌گذارند.
# فایل .env را هرگز در گیت منتشر نکنید.
#
# نکته: بیشتر گزینه‌های «رفتاری» فقط مقدار اولیه‌اند. پس از اولین اجرا در دیتابیس
# ذخیره می‌شوند و از «Saved Messages» با دستور /ai help قابل تغییرند.
# ============================================================

# ---------------- تلگرام (حساب شخصی؛ بدون Premium و بدون BotFather) ----------------
# از https://my.telegram.org ← API development tools
TG_API_ID=
TG_API_HASH=
# شماره‌ی تلگرام با کد کشور، مثل +989121234567
TG_PHONE=
# مسیر فایل نشست (Session) — جدا از دیتابیس نگهداری می‌شود و دسترسی آن 600 است.
# (پسوند .session خودکار اضافه می‌شود)
TG_SESSION_PATH=data/session/assistant

# ---------------- الزامی ----------------
# کلید API سرویس هوش مصنوعی (برای Ollama/LM Studio هر مقدار دلخواه مثل none)
AI_API_KEY=

# ---------------- هوش مصنوعی ----------------
# آدرس API سازگار با OpenAI. خالی = سرویس رسمی OpenAI.
#   OpenRouter : https://openrouter.ai/api/v1
#   Groq       : https://api.groq.com/openai/v1
#   Ollama     : http://localhost:11434/v1
AI_BASE_URL=
# مدل متنی
AI_MODEL=gpt-4o-mini
# مدل مخصوص تحلیل تصویر (اختیاری؛ خالی = همان AI_MODEL که باید Vision داشته باشد)
AI_VISION_MODEL=
AI_TEMPERATURE=0.7
# حداکثر توکن پاسخ (۰ = بدون محدودیت)
AI_MAX_TOKENS=600
AI_TIMEOUT=60
# تعداد تلاش مجدد در خطاهای موقتی (قطعی، 5xx، محدودیت نرخ)
AI_MAX_RETRIES=3

# ---------------- ارائه‌دهنده‌ی پشتیبان (اختیاری) ----------------
# اگر سرویس اصلی از کار افتاد یا محدود شد، ربات به‌صورت خودکار از این مدل استفاده می‌کند.
# فقط وقتی فعال می‌شود که AI_FALLBACK_MODEL پر باشد. کلید/آدرس خالی = همان سرویس اصلی.
AI_FALLBACK_MODEL=
AI_FALLBACK_API_KEY=
AI_FALLBACK_BASE_URL=

# ---------------- پیام صوتی (تبدیل صدا به متن) ----------------
# نیازمند سرویسی با endpoint استاندارد /audio/transcriptions (OpenAI، Groq، ...).
# اگر AI_BASE_URL شما از صدا پشتیبانی نمی‌کند، برای این بخش آدرس/کلید جدا بدهید.
TRANSCRIPTION_MODEL=whisper-1
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_BASE_URL=
# زبان صدا برای دقت بیشتر (مثلاً fa) — خالی = تشخیص خودکار
TRANSCRIPTION_LANGUAGE=
# پیام‌های صوتیِ طولانی‌تر از این (ثانیه) پردازش نمی‌شوند
MAX_AUDIO_SECONDS=300
# حداکثر حجم عکس/صدا (مگابایت). حجم قبل از دانلود بررسی می‌شود.
MAX_MEDIA_MB=10
# پوشه‌ی موقت دانلود رسانه (فایل‌ها بعد از پردازش پاک می‌شوند)
TEMP_DIR=data/tmp

# ---------------- رفتار دستیار (مقدار اولیه؛ با /ai set قابل تغییر) ----------------
# تحلیل تصویر و تبدیل صدا
VISION_ENABLED=true
VOICE_ENABLED=true
# حداقل فاصله بین پاسخ‌ها در هر چت (ثانیه)
COOLDOWN_SECONDS=3
# مهلت جمع‌کردن پیام‌های پشت‌سرهم قبل از پاسخ (ثانیه؛ ۰ = غیرفعال)
DEBOUNCE_SECONDS=2.5
# تعداد پیام‌های قبلی چت که به مدل داده می‌شود (۰ = بدون حافظه)
HISTORY_SIZE=12
# وقتی خودتان در چتی پاسخ دستی می‌دهید، ربات چند دقیقه ساکت بماند (۰ = غیرفعال)
PAUSE_MINUTES=60
# سقف پیام در ساعت برای هر چت (ضد اسپم؛ ۰ = نامحدود)
RATE_LIMIT_PER_HOUR=30
# حداکثر پاسخ‌های «پشت‌سرهم» دستیار در یک چت بدون دخالت شما؛ بعد از آن چت موقتاً ساکت می‌شود (۰ = نامحدود)
MAX_CONSECUTIVE_REPLIES=20
# اگر تلگرام FloodWait داد و مدت آن از این مقدار (ثانیه) بیشتر بود، منتظر نمی‌مانیم و پاسخ ارسال نمی‌شود
MAX_FLOOD_WAIT_SECONDS=90
# اجازه‌ی تحویل گفتگو به انسان (دستیار تشخیص می‌دهد و در Saved Messages به شما خبر می‌دهد)
HANDOFF_ENABLED=true
HANDOFF_MESSAGE=
# علامت‌زدن پیام‌ها به‌عنوان «خوانده‌شده» هنگام پاسخ
MARK_AS_READ=false
# حداقل مدت نمایش «در حال تایپ...» (ثانیه)
MIN_TYPING_SECONDS=1.5
# پیامی که اگر هوش مصنوعی کاملاً در دسترس نبود ارسال شود. خالی = چیزی ارسال نشود.
FALLBACK_MESSAGE=
# پرامپت اولیه (خالی = پرامپت داخلی)
DEFAULT_SYSTEM_PROMPT=
# سقف حجم «دانش کسب‌وکار» (کاراکتر)
KNOWLEDGE_MAX_CHARS=12000

# ---------------- ساعت کاری (مقدار اولیه) ----------------
# off | inside (فقط در ساعت کاری) | outside (فقط خارج از ساعت کاری)
SCHEDULE_MODE=off
WORK_START=09:00
WORK_END=18:00
# روزها: mon,tue,wed,thu,fri,sat,sun یا all
WORK_DAYS=mon,tue,wed,thu,fri
# منطقه‌ی زمانی IANA
TIMEZONE=Asia/Tehran

# ---------------- ذخیره‌سازی و لاگ ----------------
# مسیر دیتابیس SQLite (جدا از فایل Session)
# DATABASE_PATH=data/assistant.db
LOG_MAX_ROWS=10000
# مسیر فایل قفل اجرا (برای جلوگیری از اجرای هم‌زمان دو نمونه)؛ اسکریپت‌ها همین پیش‌فرض را می‌خوانند
# LOCK_PATH=data/assistant.lock
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
